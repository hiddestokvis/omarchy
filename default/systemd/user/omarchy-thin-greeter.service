[Unit]
Description=Omarchy thin client sign-in
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=OMARCHY_THIN=1
ConditionPathExists=/etc/omarchy-thin/thin.conf

[Service]
Type=simple
ExecStart=/bin/bash -c ". /usr/share/omarchy/default/bash/env-bootstrap; exec omarchy-thin-greeter"
Restart=always
RestartSec=1

[Install]
WantedBy=graphical-session.target

[Unit]
Description=Omarchy thin client speakers
After=omarchy-thin-display.service
PartOf=omarchy-thin-session.target

[Service]
Type=simple
ExecStart=/bin/bash -c ". /usr/share/omarchy/default/bash/env-bootstrap; exec omarchy-thin-audio speakers"
Restart=always
RestartSec=2
# Audio is switched off in thin.conf.
RestartPreventExitStatus=77
SuccessExitStatus=77


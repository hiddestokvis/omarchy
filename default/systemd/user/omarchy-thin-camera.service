[Unit]
Description=Omarchy thin client camera shared with the server
# Started and stopped by omarchy-thin-camera; never on its own, so the camera
# is only live while the user has switched it on.
After=omarchy-thin-display.service
PartOf=omarchy-thin-session.target

[Service]
Type=simple
ExecStart=/bin/bash -c ". /usr/share/omarchy/default/bash/env-bootstrap; exec omarchy-thin-camera stream"
Restart=on-failure
RestartSec=2

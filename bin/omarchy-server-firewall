#!/bin/bash

# omarchy:summary=Load the per-person network rules from each profile into the server firewall
# omarchy:args=[--apply|--show]
# omarchy:requires-sudo=true

# Outbound rules per person, matched on the uid of the process that opens the
# connection (nftables meta skuid), in a table of its own next to ufw's: ufw
# still decides what may come in, this decides what each person's apps may
# reach. Loopback and DNS are always allowed so local services and name
# lookups keep working.

set -euo pipefail

etc=${OMARCHY_SERVER_ETC:-/etc/omarchy-server}
users_file=$etc/users
rules_file=$etc/firewall.nft

rule_for() {
  local entry=$1 proto="" ports="" address="" match=()

  if [[ $entry == *@* ]]; then
    address=${entry#*@}
    entry=${entry%@*}
  fi
  if [[ $entry =~ ^(tcp|udp):([0-9]+(-[0-9]+)?)$ ]]; then
    proto=${BASH_REMATCH[1]}
    ports=${BASH_REMATCH[2]}
  elif [[ -n $entry ]]; then
    address=$entry
  fi

  if [[ -n $address ]]; then
    if [[ $address == *:* ]]; then
      match+=(ip6 daddr "$address")
    elif [[ $address =~ ^[0-9.]+(/[0-9]+)?$ ]]; then
      match+=(ip daddr "$address")
    else
      echo "omarchy-server-firewall: skipping '$1' (use addresses, not host names)" >&2
      return 1
    fi
  fi
  [[ -n $proto ]] && match+=("$proto" dport "$ports")

  (( ${#match[@]} )) || return 1
  echo "${match[*]}"
}

generate() {
  local user profile uid chain rule entry jumps=() chains=()

  while read -r user profile _; do
    [[ -n $user ]] || continue
    uid=$(id -u "$user" 2>/dev/null) || continue
    [[ -f $etc/profiles/$profile.conf ]] || continue

    NETWORK=allow NETWORK_ALLOW=() NETWORK_DENY=()
    source "$etc/profiles/$profile.conf"
    [[ $NETWORK == "deny" ]] || (( ${#NETWORK_DENY[@]} )) || continue

    chain="person_${user//-/_}"
    jumps+=("    meta skuid $uid jump $chain")
    chains+=("  chain $chain {")
    if [[ $NETWORK == "deny" ]]; then
      for entry in "${NETWORK_ALLOW[@]}"; do
        rule=$(rule_for "$entry") && chains+=("    $rule accept")
      done
      chains+=("    counter reject")
    else
      for entry in "${NETWORK_DENY[@]}"; do
        rule=$(rule_for "$entry") && chains+=("    $rule counter reject")
      done
    fi
    chains+=("  }")
  done <"$users_file"

  echo "# Generated by omarchy-server-firewall from $users_file and the profiles."
  echo "table inet omarchy_server"
  echo "delete table inet omarchy_server"
  echo "table inet omarchy_server {"
  echo "  chain output {"
  echo "    type filter hook output priority filter + 10; policy accept;"
  echo "    oifname \"lo\" accept"
  echo "    ct state established,related accept"
  echo "    meta l4proto { tcp, udp } th dport 53 accept"
  printf '%s\n' "${jumps[@]}"
  echo "  }"
  printf '%s\n' "${chains[@]}"
  echo "}"
}

case ${1:---apply} in
--show)
  generate
  ;;
--apply)
  if (( EUID != 0 )); then
    exec sudo "$0" "$@"
  fi
  generate >"$rules_file.new"
  nft -c -f "$rules_file.new"
  mv "$rules_file.new" "$rules_file"
  nft -f "$rules_file"
  ;;
*)
  echo "Usage: omarchy-server-firewall [--apply|--show]" >&2
  exit 1
  ;;
esac

#!/bin/bash

# omarchy:summary=Stop using an Omarchy server and run apps on this device again

set -uo pipefail

systemctl --user disable --now \
  omarchy-thin-camera.service omarchy-thin-notifications.service \
  omarchy-thin-mic.service omarchy-thin-speakers.service omarchy-thin.service 2>/dev/null

rm -f "$HOME/.config/uwsm/env.d/50-omarchy-thin"
rm -rf "$HOME/.local/share/omarchy-thin"

echo "Thin client mode is off. Log out and back in to finish."
echo "Your settings stay in ~/.config/omarchy/thin.conf for next time."

#!/bin/bash

# omarchy:summary=Show who is on this Omarchy server, from which device, and what they use

printf '%-16s %-12s %-12s %-18s %10s %10s\n' USER PROFILE DESKTOP DEVICE MEMORY CPU-TIME

while read -r user profile _; do
  [[ -n $user ]] || continue
  uid=$(id -u "$user" 2>/dev/null) || continue

  desktop=stopped device=-
  if pgrep -u "$uid" -x wprsd >/dev/null; then
    desktop=detached
    attached=/run/user/$uid/omarchy-thin/attached
    if sudo -n test -f "$attached" 2>/dev/null; then
      read -r pid device_name < <(sudo -n cat "$attached")
      if [[ $(ps -o comm= -p "$pid" 2>/dev/null) == sshd* ]]; then
        desktop=attached
        device=${device_name:--}
      fi
    fi
  fi

  memory=$(systemctl show "user-$uid.slice" -p MemoryCurrent --value 2>/dev/null)
  cpu=$(systemctl show "user-$uid.slice" -p CPUUsageNSec --value 2>/dev/null)
  [[ $memory =~ ^[0-9]+$ ]] && memory=$(numfmt --to=iec "$memory") || memory=-
  [[ $cpu =~ ^[0-9]+$ ]] && cpu="$((cpu / 1000000000))s" || cpu=-

  printf '%-16s %-12s %-12s %-18s %10s %10s\n' "$user" "$profile" "$desktop" "$device" "$memory" "$cpu"
done </etc/omarchy-server/users 2>/dev/null

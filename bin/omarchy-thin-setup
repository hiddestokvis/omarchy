#!/bin/bash

# omarchy:summary=Turn this device into a thin client of an Omarchy server
# omarchy:args=[user@server] [--port <port>] [--slim]
# omarchy:examples=omarchy thin setup alice@studio.local | omarchy thin setup alice@10.0.0.5 --port 2222 --slim

# Apps, files and processing stay on the server. This device keeps the
# compositor, the Omarchy shell and terminals, and forwards its speakers,
# microphone and camera. --slim also removes the big desktop apps that now
# run on the server, to free disk and memory on small devices.

set -euo pipefail

source "$OMARCHY_PATH/default/thin/client.sh"

server=""
port=22
slim=0
while (($#)); do
  case $1 in
  --port) port=$2; shift 2 ;;
  --port=*) port=${1#--port=}; shift ;;
  --slim) slim=1; shift ;;
  -h | --help)
    echo "Usage: omarchy-thin-setup [user@server] [--port <port>] [--slim]"
    exit 0
    ;;
  *) server=$1; shift ;;
  esac
done

if [[ -z $server ]]; then
  server=$(gum input --placeholder "alice@omarchy-server" --prompt "Omarchy server (user@host): ")
fi
if [[ $server != *@* ]]; then
  server="$USER@$server"
fi

echo "Installing thin client packages..."
mapfile -t packages < <(grep -vE '^\s*(#|$)' "$OMARCHY_PATH/install/omarchy-thin.packages")
omarchy-pkg-add "${packages[@]}"

if [[ ! -f $HOME/.ssh/id_ed25519 ]]; then
  mkdir -p -m 700 "$HOME/.ssh"
  ssh-keygen -q -t ed25519 -N "" -C "$USER@$(hostname) omarchy-thin" -f "$HOME/.ssh/id_ed25519"
fi

echo "Authorizing this device on $server (asks for your server password once)..."
ssh-copy-id -i "$HOME/.ssh/id_ed25519.pub" -p "$port" "$server"

if ! ssh -p "$port" -o BatchMode=yes "$server" 'command -v omarchy-server-session waypipe' >/dev/null; then
  echo "The server is not ready. On the server run: omarchy server setup && omarchy server user add $USER" >&2
  exit 1
fi
remote_runtime=$(ssh -p "$port" -o BatchMode=yes "$server" 'echo "/run/user/$(id -u)"')

config_dir=${OMARCHY_THIN_CONFIG%/*}
mkdir -p "$config_dir"
[[ -f $OMARCHY_THIN_CONFIG ]] || cp "$OMARCHY_PATH/default/thin/thin.conf" "$OMARCHY_THIN_CONFIG"
sed -i \
  -e "s|^OMARCHY_THIN_SERVER=.*|OMARCHY_THIN_SERVER=\"$server\"|" \
  -e "s|^OMARCHY_THIN_PORT=.*|OMARCHY_THIN_PORT=$port|" \
  -e "s|^OMARCHY_THIN_REMOTE_RUNTIME=.*|OMARCHY_THIN_REMOTE_RUNTIME=\"$remote_runtime\"|" \
  "$OMARCHY_THIN_CONFIG"

mkdir -p "$HOME/.config/uwsm/env.d"
ln -sfn "$OMARCHY_PATH/default/thin/uwsm-env" "$HOME/.config/uwsm/env.d/50-omarchy-thin"

units=(omarchy-thin.service omarchy-thin-speakers.service omarchy-thin-mic.service omarchy-thin-notifications.service omarchy-thin-camera.service)
for unit in "${units[@]}"; do
  if ! systemctl --user cat "$unit" >/dev/null 2>&1; then
    systemctl --user link "$OMARCHY_PATH/default/systemd/user/$unit"
  fi
done
systemctl --user daemon-reload
systemctl --user enable omarchy-thin.service omarchy-thin-speakers.service omarchy-thin-mic.service omarchy-thin-notifications.service
systemctl --user restart omarchy-thin.service

if (( slim )); then
  mapfile -t heavy < <(grep -vE '^\s*(#|$)' "$OMARCHY_PATH/install/omarchy-thin-slim.packages")
  installed=()
  for package in "${heavy[@]}"; do
    omarchy-pkg-present "$package" && installed+=("$package")
  done
  if (( ${#installed[@]} )); then
    echo "Removing apps that now run on the server: ${installed[*]}"
    omarchy-pkg-drop "${installed[@]}"
  fi
fi

echo "Syncing the server's apps into the launcher..."
omarchy-thin-sync-apps --force || echo "App sync will retry on the next login." >&2

echo
echo "Done. Log out and back in to start using $server."

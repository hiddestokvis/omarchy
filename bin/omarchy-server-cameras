#!/bin/bash

# omarchy:summary=Reserve a private virtual webcam for each thin client user
# omarchy:args=[--apply|--device <user>]
# omarchy:hidden=true

# Users are listed one per line in /etc/omarchy-server/users. The user on line
# N gets /dev/video(39+N), a v4l2loopback device only they can open, which
# their thin client's camera stream feeds. exclusive_caps makes browsers list
# it as a camera only while the stream is on.

set -euo pipefail

users_file=/etc/omarchy-server/users
first_device=40

user_index() {
  grep -nxF "$1" "$users_file" 2>/dev/null | head -1 | cut -d: -f1
}

case ${1:---apply} in
--device)
  index=$(user_index "${2:?Usage: omarchy-server-cameras --device <user>}")
  [[ -n $index ]] && echo "/dev/video$((first_device + index - 1))"
  ;;
--apply)
  if (( EUID != 0 )); then
    echo "omarchy-server-cameras --apply must run as root" >&2
    exit 1
  fi

  mapfile -t users < <(grep -vE '^\s*$' "$users_file" 2>/dev/null || true)
  count=${#users[@]}

  rules=/etc/udev/rules.d/71-omarchy-server-cameras.rules
  echo "# Generated by omarchy-server-cameras from $users_file" >"$rules"

  if (( count == 0 )); then
    rm -f /etc/modprobe.d/omarchy-server-cameras.conf /etc/modules-load.d/omarchy-server-cameras.conf
  else
    numbers=() labels=() caps=()
    for i in "${!users[@]}"; do
      numbers+=("$((first_device + i))")
      labels+=("Thin-Client-Camera")
      caps+=(1)
      echo "SUBSYSTEM==\"video4linux\", KERNEL==\"video$((first_device + i))\", OWNER=\"${users[$i]}\", GROUP=\"root\", MODE=\"0600\"" >>"$rules"
    done

    (
      IFS=,
      echo "options v4l2loopback devices=$count video_nr=${numbers[*]} card_label=${labels[*]} exclusive_caps=${caps[*]}"
    ) >/etc/modprobe.d/omarchy-server-cameras.conf
    echo v4l2loopback >/etc/modules-load.d/omarchy-server-cameras.conf
  fi

  udevadm control --reload || true

  # Reload the module now if nobody is using a camera; otherwise at next boot.
  if [[ -d /sys/module/v4l2loopback ]]; then
    if (( $(cat /sys/module/v4l2loopback/refcnt) == 0 )); then
      modprobe -r v4l2loopback
    else
      echo "A thin client camera is in use; the new camera layout applies after a reboot."
      exit 0
    fi
  fi
  if (( count > 0 )); then
    modprobe v4l2loopback || echo "Could not load v4l2loopback; reboot after the kernel update finishes." >&2
    udevadm trigger --subsystem-match=video4linux || true
  fi
  ;;
*)
  echo "Usage: omarchy-server-cameras [--apply|--device <user>]" >&2
  exit 1
  ;;
esac

#!/bin/bash

# omarchy:summary=Open a shell or run a terminal command on the Omarchy server
# omarchy:args=[command] [args...]
# omarchy:hidden=true

# Runs inside a terminal on the thin client. Only text crosses the network, and
# it rides the signed-in connection, so a new terminal opens without a handshake.

source "$OMARCHY_PATH/default/thin/client.sh"
thin_load_config || exit 1

if ! thin_connected; then
  echo "Not signed in to the Omarchy server."
  sleep 3
  exit 1
fi

remote=(omarchy-server-exec)
if (($#)); then
  remote+=("$(thin_remote_command "$@")")
fi

exec ssh "${OMARCHY_THIN_SSH_OPTS[@]}" -o ControlMaster=no -o BatchMode=yes -t "$OMARCHY_THIN_DESTINATION" -- "${remote[@]}"
